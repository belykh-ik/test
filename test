#!/usr/bin/env bash
set -euo pipefail

kubectl version --short || true

kubectl get nodes -o wide

kubectl -n kube-system get pods -o wide

kubectl -n kube-system get ds,deploy -o wide | grep -E 'calico|kube-proxy|coredns|kube-dns' || true

kubectl get svc kubernetes -o wide
kubectl get endpoints kubernetes -o wide

kubectl get crd | grep -E 'projectcalico|tigera' || true

kubectl -n kube-system get ds calico-node -o jsonpath='{.spec.template.spec.containers[*].name}{"\n"}{.spec.template.spec.containers[*].image}{"\n"}' || true
kubectl -n kube-system get ds calico-node -o jsonpath='{.spec.template.spec.initContainers[*].name}{"\n"}{.spec.template.spec.initContainers[*].image}{"\n"}' || true

kubectl -n kube-system get deploy calico-kube-controllers -o jsonpath='{.spec.template.spec.containers[*].name}{"\n"}{.spec.template.spec.containers[*].image}{"\n"}' || true

kubectl -n tigera-operator get deploy -o wide 2>/dev/null || true
kubectl -n tigera-operator get deploy -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.template.spec.containers[*].image}{"\n"}{end}' 2>/dev/null || true

kubectl get clusterinformation default -o yaml 2>/dev/null || true
kubectl get clusterinformations default -o yaml 2>/dev/null || true

kubectl -n kube-system get pods -l k8s-app=calico-node -o wide || true
kubectl -n kube-system describe pod -l k8s-app=calico-node || true
kubectl -n kube-system logs -l k8s-app=calico-node --tail=200 || true

kubectl -n kube-system get pod -l k8s-app=calico-kube-controllers -o wide 2>/dev/null || true
kubectl -n kube-system describe deploy calico-kube-controllers 2>/dev/null || true
kubectl -n kube-system logs deploy/calico-kube-controllers --tail=200 2>/dev/null || true

kubectl -n kube-system get pods -l k8s-app=kube-dns -o wide 2>/dev/null || true
kubectl -n kube-system logs -l k8s-app=kube-dns --tail=200 2>/dev/null || true
kubectl -n kube-system logs -l k8s-app=coredns --tail=200 2>/dev/null || true

kubectl -n kube-system get ds kube-proxy -o wide 2>/dev/null || true
kubectl -n kube-system logs -l k8s-app=kube-proxy --tail=200 2>/dev/null || true

kubectl -n kube-system get cm calico-config -o yaml 2>/dev/null || true
