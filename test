#!/bin/bash

GROUP=com/sbdagroup
PROJECT=667
TOKEN=yourtoken
GL_URL="https://gl.example.com/api/v4/projects/$PROJECT/packages/maven"

ARTIFACTS=(apix-core apix-docs apix-admin apix-uploads)
VERSION="1.2.18-dev"

for ART in "${ARTIFACTS[@]}"; do
  mkdir -p "$ART"
  
  curl -H "Private-Token: $TOKEN" \
       "$GL_URL/$GROUP/$ART/$VERSION/$ART-$VERSION.jar" \
       -o "$ART/$ART-$VERSION.jar"

  curl -H "Private-Token: $TOKEN" \
       "$GL_URL/$GROUP/$ART/$VERSION/$ART-$VERSION.pom" \
       -o "$ART/$ART-$VERSION.pom"

  # потом загрузить в Nexus
done