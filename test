# keycloak-production-simple.yaml - Упрощенная production конфигурация

global:
  imageRegistry: nexus.test.ru
  security:
    allowInsecureImages: true

image:
  repository: bitnamilegacy/keycloak

# Production режим
production: true
proxy: edge

# TLS - используем сертификаты из Ingress
tls:
  enabled: true
  autoGenerated:
    enabled: false

# Внешняя PostgreSQL
postgresql:
  enabled: false

externalDatabase:
  host: postgresql.keycloak.svc.cluster.local
  port: 5432
  database: keycloak_db
  user: keycloak_user
  password: sXl9G4_3lsJ3

# Администратор
auth:
  adminUser: admin
  adminPassword: Akw03Lsp_s9ekS

# Trusted CA (если есть)
trustedCertsExistingSecret: test-ca

# Сервис
service:
  type: ClusterIP
  ports:
    https: 8443

# Ingress с TLS
ingress:
  enabled: true
  ingressClassName: nginx
  hostname: kc-test.umka.test.ru
  path: /
  pathType: Prefix
  
  # TLS настройки
  tls: true
  selfSigned: false
  extraTls:
    - hosts:
        - kc-test.umka.test.ru
      secretName: keycloak-tls
  
  # Аннотации
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: "HTTPS"
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/force-ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"

# Health checks с увеличенными таймаутами
livenessProbe:
  enabled: true
  initialDelaySeconds: 300
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 6

readinessProbe:
  enabled: true
  initialDelaySeconds: 60
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 6

# Startup probe
startupProbe:
  enabled: true
  initialDelaySeconds: 30
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 60

# Ресурсы
resources:
  requests:
    memory: "1Gi"
    cpu: "500m"
  limits:
    memory: "2Gi"
    cpu: "2000m"

# Переменные окружения
extraEnvVars:
  - name: KC_HOSTNAME
    value: "kc-test.umka.test.ru"
  - name: KC_HOSTNAME_STRICT
    value: "true"
  - name: KC_HOSTNAME_STRICT_HTTPS
    value: "true"
  - name: KC_PROXY
    value: "edge"
  - name: KEYCLOAK_PRODUCTION
    value: "true"

# Количество реплик
replicaCount: 1
