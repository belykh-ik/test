#!/bin/bash
set -euo pipefail

# ====== НАСТРОЙКИ ======
GIT_URL="https://git.example.com/vendor/project.git"
USERNAME="contractor-user"
TOKEN="glpat-xxxxxxxxxxxxxxxx"

DEST_DIR="project"

# ====== ПРОВЕРКИ ======
if [[ -d "$DEST_DIR" ]]; then
  echo "❌ Директория $DEST_DIR уже существует"
  exit 1
fi

# ====== КЛОНИРОВАНИЕ ======
echo "▶ Клонирую репозиторий..."
git clone "https://${USERNAME}:${TOKEN}@${GIT_URL#https://}" "$DEST_DIR"

echo "✅ Репозиторий успешно скачан в $DEST_DIR"
