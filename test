#!/bin/bash

# Создаем .env файл если его нет
if [ ! -f .env ]; then
    echo "REDIS_PASSWORD=$(openssl rand -base64 32)" > .env
    echo "Создан .env файл с автоматически сгенерированным паролем"
fi

# Загружаем переменные
source .env

# Создаем redis.conf из шаблона
envsubst < redis.conf.template > redis.conf

# Запускаем Redis
docker-compose up -d

echo "Redis запущен в production режиме"
echo "Пароль: $REDIS_PASSWORD"
echo "Порт: 6379"