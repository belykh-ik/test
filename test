variables:
  HELM_CUSTOM_VALUES: ""  # пустое значение, будет переопределено

deploy:
  before_script:
    - export HELM_CUSTOM_VALUES="./values.custom.${CI_PIPELINE_ID}.json"
    - cp values.custom.json "$HELM_CUSTOM_VALUES"
    - jq --arg PIPELINE_ID "$CI_PIPELINE_ID" '.app += { "pipeline_id": $PIPELINE_ID }' "$HELM_CUSTOM_VALUES" > tmp && mv tmp "$HELM_CUSTOM_VALUES"