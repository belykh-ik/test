#!/usr/bin/env bash
set -euo pipefail

kubectl version --short || true
kubectl cluster-info || true

kubectl get nodes -o wide || true
kubectl -n kube-system get pods -o wide || true

kubectl get svc kubernetes -o wide || true
kubectl get endpoints kubernetes -o wide || true
kubectl get endpointslices -l kubernetes.io/service-name=kubernetes -A || true

kubectl -n kube-system get ds kube-proxy -o wide || true
kubectl -n kube-system get cm kube-proxy -o yaml || true

kubectl -n kube-system get ds calico-node -o jsonpath='{.spec.template.spec.containers[*].image}{"\n"}' || true
kubectl -n kube-system get deploy calico-kube-controllers -o jsonpath='{.spec.template.spec.containers[*].image}{"\n"}' || true

kubectl -n kube-system get pods -l k8s-app=kube-proxy -o wide || true
kubectl -n kube-system get pods -l k8s-app=calico-node -o wide || true
kubectl -n kube-system get pods -l k8s-app=calico-kube-controllers -o wide || true
kubectl -n kube-system get pods -l k8s-app=kube-dns -o wide || true

kubectl -n kube-system logs -l k8s-app=calico-kube-controllers --tail=200 --all-containers=true || true
kubectl -n kube-system logs -l k8s-app=kube-dns --tail=200 --all-containers=true || true
kubectl -n kube-system logs -l k8s-app=kube-proxy --tail=200 --all-containers=true || true
kubectl -n kube-system logs -l k8s-app=calico-node --tail=200 --all-containers=true || true

kubectl -n kube-system get events --sort-by=.lastTimestamp | tail -n 200 || true

kubectl -n kube-system delete pod netcheck --ignore-not-found=true || true
kubectl -n kube-system run netcheck --image=busybox:1.36 --restart=Never --command -- sleep 3600 || true
kubectl -n kube-system wait --for=condition=Ready pod/netcheck --timeout=120s || true

kubectl -n kube-system exec netcheck -- sh -c 'echo "--- DNS"; nslookup kubernetes.default.svc.cluster.local 2>&1 || true'
kubectl -n kube-system exec netcheck -- sh -c 'echo "--- TCP to ClusterIP 10.233.0.1:443"; (nc -vz -w 3 10.233.0.1 443 2>&1 || true)'
kubectl -n kube-system exec netcheck -- sh -c 'echo "--- TCP to kubernetes.default:443"; (nc -vz -w 3 kubernetes.default 443 2>&1 || true)'

APISERVER_HOST="$(kubectl get svc kubernetes -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)"
if [[ -n "${APISERVER_HOST}" ]]; then
  kubectl -n kube-system exec netcheck -- sh -c "echo \"--- ClusterIP from svc: ${APISERVER_HOST}\""
fi

kubectl -n kube-system delete pod netcheck-hostnet --ignore-not-found=true || true
kubectl -n kube-system run netcheck-hostnet --overrides='{"spec":{"hostNetwork":true,"dnsPolicy":"ClusterFirstWithHostNet","containers":[{"name":"c","image":"busybox:1.36","command":["sh","-c","sleep 3600"]}]}}' --restart=Never || true
kubectl -n kube-system wait --for=condition=Ready pod/netcheck-hostnet --timeout=120s || true
kubectl -n kube-system exec netcheck-hostnet -- sh -c 'echo "--- HostNetwork TCP to ClusterIP 10.233.0.1:443"; (nc -vz -w 3 10.233.0.1 443 2>&1 || true)'
kubectl -n kube-system exec netcheck-hostnet -- sh -c 'echo "--- HostNetwork DNS"; nslookup kubernetes.default.svc.cluster.local 2>&1 || true'

kubectl -n kube-system get pods -o wide || true
