$Server = "server"
$TimeoutMs = 300

for ($Port = 1; $Port -le 65535; $Port++) {
    try {
        $TcpClient = New-Object System.Net.Sockets.TcpClient
        $Async = $TcpClient.BeginConnect($Server, $Port, $null, $null)

        if ($Async.AsyncWaitHandle.WaitOne($TimeoutMs, $false) -and $TcpClient.Connected) {
            Write-Output "$Server:$Port - OPEN"
        }

        $TcpClient.Close()
    }
    catch {
        # ничего не выводим
    }
}
