$Server = "server"
$TimeoutMs = 300

1..65535 | ForEach-Object -Parallel {
    try {
        $TcpClient = [System.Net.Sockets.TcpClient]::new()
        $Async = $TcpClient.BeginConnect($using:Server, $_, $null, $null)

        if ($Async.AsyncWaitHandle.WaitOne($using:TimeoutMs, $false) -and $TcpClient.Connected) {
            "$using:Server:$($_) - OPEN"
        }

        $TcpClient.Close()
    } catch {}
} -ThrottleLimit 200
