#!/bin/bash

set -e

echo ">>> Detecting architecture..."
ARCH=$(uname -m)
if [[ "$ARCH" == "x86_64" ]]; then
    OC_URL="https://mirror.openshift.com/pub/openshift-v4/clients/ocp/latest/openshift-client-linux.tar.gz"
else
    echo "Unsupported architecture: $ARCH"
    exit 1
fi

echo ">>> Downloading OpenShift CLI..."
wget -O oc.tar.gz $OC_URL --no-check-certificate

echo ">>> Extracting..."
tar -xvf oc.tar.gz

echo ">>> Installing to /usr/local/bin ..."
sudo mv oc kubectl /usr/local/bin/

echo ">>> Setting permissions..."
sudo chmod +x /usr/local/bin/oc
sudo chmod +x /usr/local/bin/kubectl

echo ">>> Cleaning up..."
rm -f oc.tar.gz README.md LICENSE

echo ">>> Installation complete!"
oc version || echo "Check PATH manually"