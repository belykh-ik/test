#!/bin/bash

set -euo pipefail

# ========= НАСТРОЙКИ (МОЖНО ПЕРЕОПРЕДЕЛИТЬ ЧЕРЕЗ ENV) =========
GITLAB_URL="${GITLAB_URL:-https://gitlab.com}"
REG_TOKEN="${REG_TOKEN:-PASTE_YOUR_TOKEN_HERE}"
RUNNER_NAME="${RUNNER_NAME:-shell-runner}"
RUNNER_TAGS="${RUNNER_TAGS:-shell}"
# ===============================================================

if [[ "$REG_TOKEN" == "PASTE_YOUR_TOKEN_HERE" ]]; then
  echo "[ERROR] Не задан REG_TOKEN. Укажи его в скрипте или через переменную окружения REG_TOKEN."
  exit 1
fi

if [[ $EUID -ne 0 ]]; then
  echo "[+] Скрипт требует root. Перезапускаю через sudo..."
  exec sudo -E "$0" "$@"
fi

echo "[+] Обновление пакетов..."
apt update -y

echo "[+] Установка зависимостей..."
apt install -y curl ca-certificates

echo "[+] Подключение репозитория GitLab Runner..."
curl -L https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh | bash

echo "[+] Установка gitlab-runner..."
apt install -y gitlab-runner

echo "[+] Регистрация shell runner..."
gitlab-runner register \
  --non-interactive \
  --url "$GITLAB_URL" \
  --registration-token "$REG_TOKEN" \
  --executor "shell" \
  --description "$RUNNER_NAME" \
  --tag-list "$RUNNER_TAGS" \
  --run-untagged="false" \
  --locked="false"

echo "[+] Включение и запуск сервиса gitlab-runner..."
systemctl enable gitlab-runner
systemctl restart gitlab-runner

echo
echo "[✓] Shell GitLab Runner установлен и запущен."
echo "    URL:  $GITLAB_URL"
echo "    Name: $RUNNER_NAME"
echo "    Tags: $RUNNER_TAGS"
echo
echo "Проверь в GitLab в Settings → CI/CD → Runners, что раннер в статусе online."