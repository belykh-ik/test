prepare_values:
  stage: pre
  image: alpine:3.19
  script:
    - apk add --no-cache jq
    - export HELM_CUSTOM_VALUES="./values.custom.${CI_PIPELINE_ID}.json"
    - echo "🔧 Генерация $HELM_CUSTOM_VALUES"
    - cp values.custom.json "$HELM_CUSTOM_VALUES"
    - jq --arg PIPELINE_ID "$CI_PIPELINE_ID" \
         '.app += { "pipeline_id": $PIPELINE_ID }' \
         "$HELM_CUSTOM_VALUES" > tmp && mv tmp "$HELM_CUSTOM_VALUES"
    # ❗ Создаём helm.env без кавычек и пробелов
    - echo "HELM_CUSTOM_VALUES=$HELM_CUSTOM_VALUES" > helm.env
  artifacts:
    paths:
      - values.custom.${CI_PIPELINE_ID}.json
    reports:
      dotenv: helm.env