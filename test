#!/bin/bash

GROUP=com/test
TOKEN="glpat-vrv3r5e43ver54"
GL_URL="https://gl.test.com/api/v4/projects/667/packages/maven"

ARTIFACTS=(appix-notifications)
VERSION="1.2.18-dev"

for ART in "${ARTIFACTS[@]}"; do
    echo "===> Processing $ART:$VERSION"
    mkdir -p "$ART"

    # URL к директории
    URL="$GL_URL/$GROUP/$ART/$VERSION/"

    echo "Listing files at: $URL"

    # Скачиваем HTML и вытаскиваем имена файлов
    curl -s -H "Private-Token: $TOKEN" "$URL" \
      | grep -oP '(?<=href=")[^"]+' \
      | grep -v "\.\./" \
      | while read FILE; do
        
        echo "Downloading: $FILE"

        curl -s -H "Private-Token: $TOKEN" \
            -o "$ART/$FILE" \
            "$URL$FILE"
      done
done