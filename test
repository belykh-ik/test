apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: inspection-front-ingress
  annotations:
    nginx.ingress.kubernetes.io/use-regex: "true"
    nginx.ingress.kubernetes.io/rewrite-target: /$2
spec:
  ingressClassName: nginx
  rules:
  - host: test-inspection.lee.repo.ru
    http:
      paths:
      - path: /engineer(/|$)(.*)
        pathType: ImplementationSpecific
        backend:
          service:
            name: engineer-inspection-front-service
            port:
              number: 8080
      - path: /(.*)
        pathType: ImplementationSpecific
        backend:
          service:
            name: inspection-front-service
            port:
              number: 8080
