#!/usr/bin/env bash
set -e

NS="smoke-test"

echo "=== [1] Проверка доступа к кластеру ==="
kubectl cluster-info
kubectl version --output=yaml

echo "=== [2] Проверка ноды ==="
kubectl get nodes -o wide

NODE=$(kubectl get nodes --no-headers | awk '{print $1}')
echo "Используем ноду: $NODE"

echo "--- Taints и ресурсы ---"
kubectl describe node "$NODE" | grep -E 'Taints:|Pressure|Allocatable|Capacity' || true

echo "=== [3] Снятие taint для single-node control-plane ==="
kubectl taint nodes "$NODE" node-role.kubernetes.io/control-plane- || true

echo "=== [4] kube-system pods ==="
kubectl get pods -n kube-system -o wide

echo "=== [5] Создаём тестовый namespace ==="
kubectl delete ns $NS --ignore-not-found=true
kubectl create ns $NS

echo "=== [6] Деплой тестового приложения ==="
kubectl -n $NS create deploy hello --image=nginxdemos/hello --replicas=2
kubectl -n $NS rollout status deploy/hello

echo "=== [7] ClusterIP Service ==="
kubectl -n $NS expose deploy hello --port=80 --target-port=80
kubectl -n $NS get svc,pods -o wide

echo "=== [8] Проверка DNS + доступа внутри кластера ==="
kubectl -n $NS run curl --image=curlimages/curl -it --rm -- \
  sh -c "apk add bind-tools >/dev/null && \
  echo '→ DNS:' && nslookup hello && \
  echo '→ HTTP:' && curl -sS http://hello" || true

echo "=== [9] NodePort Service ==="
kubectl -n $NS expose deploy hello --name=hello-np --type=NodePort --port=80 --target-port=80

NODE_PORT=$(kubectl -n $NS get svc hello-np -o jsonpath='{.spec.ports[0].nodePort}')
NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')

echo "Проверка NodePort: http://$NODE_IP:$NODE_PORT"
curl -sS http://127.0.0.1:$NODE_PORT | head || true

echo "=== [10] Проверка StorageClass ==="
kubectl get sc || true

DEFAULT_SC=$(kubectl get sc 2>/dev/null | grep "(default)" | awk '{print $1}' || true)

if [[ -n "$DEFAULT_SC" ]]; then
echo "→ Default StorageClass: $DEFAULT_SC"

cat <<EOF | kubectl -n $NS apply -f -
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: test-pvc
spec:
  storageClassName: $DEFAULT_SC
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Pod
metadata:
  name: pvc-tester
spec:
  containers:
  - name: app
    image: busybox
    command: ["sh","-c","echo SUCCESS > /data/out && sleep 20"]
    volumeMounts:
    - name: data
      mountPath: /data
  volumes:
  - name: data
    persistentVolumeClaim:
      claimName: test-pvc
EOF

kubectl -n $NS wait --for=condition=Ready pod/pvc-tester --timeout=60s || true
echo "Содержимое PVC:"
kubectl -n $NS exec pvc-tester -- cat /data/out || true

else
echo "→ Нет default StorageClass — пропускаем проверку PVC"
fi

echo "=== [11] Проверка Ingress (если установлен ingress-nginx) ==="
if kubectl get ns ingress-nginx >/dev/null 2>&1; then
echo "Ingress найден — проверяем"

cat <<EOF | kubectl -n $NS apply -f -
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hello
spec:
  ingressClassName: nginx
  rules:
  - host: hello.local
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: hello
            port:
              number: 80
EOF

echo "Добавь в /etc/hosts:"
echo "$NODE_IP hello.local"
echo "Проверь:"
echo "curl -H 'Host: hello.local' http://$NODE_IP/"
else
echo "→ Ingress не установлен — пропущено"
fi

echo ""
echo "✅ Проверка завершена."
echo "Если ошибок не было — кластер работает корректно."