kubectl create secret generic rabbitmq-client-cert \
  --from-file=client.p12=/path/to/your/file.p12 \
  -n <namespace>



volumes:
  - name: rabbitmq-cert
    secret:
      secretName: rabbitmq-client-cert

containers:
  - name: app
    image: your-image
    volumeMounts:
      - name: rabbitmq-cert
        mountPath: /etc/certs
        readOnly: true
    env:
      - name: RABBITMQ_CERT_PATH
        value: "/etc/certs/client.p12"