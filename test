# External Services для подключения к Docker контейнерам
# ВАЖНО: Узнай IP адрес Docker хоста и замени 192.168.1.100 на реальный IP

---
# ==========================================
# CLUSTER NETWORK SERVICES
# ==========================================

# Cluster PostgreSQL External Service
apiVersion: v1
kind: Service
metadata:
  name: cluster-postgres-external
  labels:
    app: cluster-postgres
spec:
  type: ClusterIP
  ports:
  - port: 5432
    targetPort: 5432
    protocol: TCP
    name: postgres
---
apiVersion: v1
kind: Endpoints
metadata:
  name: cluster-postgres-external
subsets:
  - addresses:
      - ip: 192.168.1.100  # ЗАМЕНИ на IP Docker хоста
    ports:
      - port: 5432
        name: postgres

---
