stages:
  - .pre
  - deploy

prepare_values:
  stage: .pre
  script:
    - echo "📦 Готовим values файл"
    - cp ./values.custom.json ./values.custom.${CI_PIPELINE_ID}.json
  artifacts:
    paths:
      - values.custom.${CI_PIPELINE_ID}.json
    expire_in: 1 hour

include:
  - project: infrastructure/common/gitlab-ci
    ref: master
    file: /java/k8s/v100_site/.gitlab-ci.yml