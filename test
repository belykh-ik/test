script:
  - echo "Поиск jar:"
  - find . -type f -name "*.jar"
  - export JAR_FILE=$(find . -type f -name "edo-data-mart-api-*.jar" | head -n 1)
  - echo "Используем JAR_FILE=$JAR_FILE"
  - ls -lh $JAR_FILE || (echo "❌ JAR не найден"; exit 1)
  - echo "Запускаем docker build"
  - docker build --build-arg JAR_FILE=$JAR_FILE -t $CURRENT_IMAGE .