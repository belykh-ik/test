data_dir: /var/lib/vector

api:
  enabled: true
  address: 0.0.0.0:8686

# =========================
# SOURCES
# =========================
sources:
  # 1) Твой вход по TLS TCP (например syslog/агенты/сканер)
  vuln_input:
    type: socket
    address: 0.0.0.0:6514
    mode: tcp
    tls:
      enabled: true
      crt_file: /etc/vector/tls/server.crt
      key_file: /etc/vector/tls/server.key
      ca_file: /etc/vector/tls/ca.crt
      verify_certificate: true          # клиент ОБЯЗАН прислать client.crt
    decoding:
      codec: json
    framing:
      method: newline_delimited

  # 2) Простой вход для тестов (без TLS), чтобы быстро проверить пайплайн
  ingest_http:
    type: http_server
    address: 0.0.0.0:8686
    path: /ingest
    encoding: json

# =========================
# TRANSFORMS
# =========================
transforms:
  normalize:
    type: remap
    inputs: ["vuln_input", "ingest_http"]
    source: |
      # базовые метаданные
      .@timestamp = now()

      # если источник не прислал "host", "service" — добавим
      if !exists(.host) { .host = get_hostname() }
      if !exists(.service) { .service = "vector" }

      # удобный флаг откуда пришло
      if exists(.path) && .path == "/ingest" {
        .ingest_source = "http"
      } else {
        .ingest_source = "tls_socket"
      }

# =========================
# SINKS
# =========================
sinks:
  # Отладочный вывод в консоль
  console_debug:
    type: console
    inputs: ["normalize"]
    encoding:
      codec: json

  # OpenSearch (через Elasticsearch bulk API)
  opensearch_logs:
    type: elasticsearch
    inputs: ["normalize"]
    endpoints: ["https://opensearch:9200"]

    # Basic auth (для PoC проще всего)
    auth:
      strategy: basic
      user: admin
      password: admin

    # TLS к OpenSearch
    tls:
      ca_file: /etc/vector/tls/ca.crt
      verify_certificate: true
      verify_hostname: false  # часто нужно false, если сертификат выдан не на имя "opensearch"

      # === OPTIONAL mTLS (раскомментируй, если хочешь клиентский сертификат на исходящее соединение) ===
      # crt_file: /etc/vector/tls/client.crt
      # key_file: /etc/vector/tls/client.key

    bulk:
      index: "vuln_input-%Y.%m.%d"
      action: "index"

    buffer:
      type: memory
      max_events: 5000
