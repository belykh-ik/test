# keycloak-values.yaml - Правильная конфигурация для dev режима

global:
  imageRegistry: nexus.test.ru
  security:
    allowInsecureImages: true

image:
  repository: bitnamilegacy/keycloak

# Development режим (без HTTPS)
production: false
proxy: edge
httpEnabled: true

# TLS отключен для dev
tls:
  enabled: false

# Внешняя PostgreSQL
postgresql:
  enabled: false

externalDatabase:
  host: postgresql.keycloak.svc.cluster.local
  port: 5432
  database: keycloak_db
  user: keycloak_user
  password: sXl9G4_3lsJ3

# Админ
auth:
  adminUser: admin
  adminPassword: Akw03Lsp_s9ekS

# Сервис
service:
  type: ClusterIP
  ports:
    http: 8080

# Ingress (для HTTP без TLS)
ingress:
  enabled: true
  ingressClassName: nginx  # или ваш ingress class
  hostname: kc-test.umka.test.ru
  path: /
  pathType: Prefix
  tls: false  # Отключаем TLS для dev
  
  # Аннотации - правильный синтаксис
  annotations:
    nginx.ingress.kubernetes.io/backend-protocol: "HTTP"
    nginx.ingress.kubernetes.io/ssl-redirect: "false"

# Health checks с увеличенными таймаутами
livenessProbe:
  enabled: true
  initialDelaySeconds: 300
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 6
  successThreshold: 1
  httpGet:
    path: /
    port: http

readinessProbe:
  enabled: true
  initialDelaySeconds: 60
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 6
  successThreshold: 1
  httpGet:
    path: /realms/master
    port: http

# Ресурсы
resources:
  requests:
    memory: "512Mi"
    cpu: "500m"
  limits:
    memory: "2Gi"
    cpu: "2000m"

# Дополнительные переменные окружения
extraEnvVars:
  - name: KC_HOSTNAME_STRICT
    value: "false"
  - name: KC_HOSTNAME_STRICT_HTTPS
    value: "false"
  - name: KC_HTTP_ENABLED
    value: "true"
  - name: KC_PROXY
    value: "edge"
  - name: KC_LOG_LEVEL
    value: "INFO"
  - name: KEYCLOAK_PRODUCTION
    value: "false"

# Количество реплик
replicaCount: 1
