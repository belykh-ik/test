apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: cvm-secret-bao
spec:
  refreshInterval: 1h

  secretStoreRef:
    name: openbao-store
    kind: SecretStore   # или ClusterSecretStore

  target:
    name: cvm-secret-bao
    creationPolicy: Owner

    template:
      type: Opaque
      engineVersion: v2
      data:
        .env: |
          KAFKA_SASL_USERNAME={{ .kafka_username }}
          KAFKA_SASL_JAAS_CONFIG_PASSWORD={{ .kafka_password }}
          DB_PASSWORD={{ .db_password }}

  data:
    - secretKey: kafka_username
      remoteRef:
        key: path/to/secret
        property: kafka_username

    - secretKey: kafka_password
      remoteRef:
        key: path/to/secret
        property: kafka_password

    - secretKey: db_password
      remoteRef:
        key: path/to/secret
        property: db_password