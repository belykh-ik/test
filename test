update_rabbitmq_secret:
  stage: deploy
  image: bitnami/kubectl:1.30
  variables:
    KUBE_NAMESPACE: service-dev
    OLD_SECRET: rabbitmq-truststore
    NEW_SECRET: rabbitmq-truststore-new
  script:
    - echo "🔍 Получаем старый секрет $OLD_SECRET"
    - DATA=$(kubectl get secret "$OLD_SECRET" -n "$KUBE_NAMESPACE" -o jsonpath='{.data.truststore\.p12}')
    - echo "📦 Создаём новый секрет $NEW_SECRET"
    - kubectl create secret generic "$NEW_SECRET" -n "$KUBE_NAMESPACE" \
        --from-literal=truststore.p12="$DATA"
    - echo "🗑️ Удаляем старый секрет $OLD_SECRET"
    - kubectl delete secret "$OLD_SECRET" -n "$KUBE_NAMESPACE"
    - echo "✅ Готово: создан $NEW_SECRET, удалён $OLD_SECRET"