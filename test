#!/usr/bin/env bash
set -euo pipefail

JDK_URL="https://github.com/adoptium/temurin21-binaries/releases/latest/download/OpenJDK21U-jdk_x64_linux_hotspot.tar.gz"
TMP_TAR="/tmp/jdk21.tar.gz"
JVM_DIR="/usr/lib/jvm"
SYMLINK="${JVM_DIR}/jdk-21"

echo "[*] Проверка архитектуры..."
ARCH=$(uname -m)
if [[ "$ARCH" != "x86_64" ]]; then
  echo "[-] Неподдерживаемая архитектура: $ARCH (ожидается x86_64)"
  exit 1
fi

echo "[*] Скачивание JDK 21..."
wget -O "$TMP_TAR" "$JDK_URL"

echo "[*] Создание каталога JVM..."
sudo mkdir -p "$JVM_DIR"

echo "[*] Определение имени каталога в архиве..."
DIR_NAME=$(tar -tf "$TMP_TAR" | head -1 | cut -d/ -f1)
JDK_PATH="${JVM_DIR}/${DIR_NAME}"

echo "[*] Распаковка JDK в ${JVM_DIR}..."
sudo tar -C "$JVM_DIR" -xzf "$TMP_TAR"

if [[ ! -d "$JDK_PATH" ]]; then
  echo "[-] Каталог JDK не найден после распаковки"
  exit 1
fi

echo "[*] Создание симлинка ${SYMLINK} -> ${JDK_PATH}"
sudo ln -sfn "$JDK_PATH" "$SYMLINK"

echo "[*] Регистрация java и javac в update-alternatives..."
sudo update-alternatives --install /usr/bin/java  java  "${SYMLINK}/bin/java"  2100
sudo update-alternatives --install /usr/bin/javac javac "${SYMLINK}/bin/javac" 2100

echo "[*] Установка JDK 21 как версии по умолчанию..."
sudo update-alternatives --set java  "${SYMLINK}/bin/java"
sudo update-alternatives --set javac "${SYMLINK}/bin/javac"

echo "[*] Проверка версии Java..."
java -version

echo
echo "[+] JDK 21 установлен успешно"
echo "[i] Каталог: ${JDK_PATH}"
echo "[i] Симлинк: ${SYMLINK}"