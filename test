---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-web-nginx-config
  namespace: test-services
data:
  default.conf: |
    upstream backend {
      server cluster-dms-api:8000;
    }

    server {
      listen 80;
      server_name localhost;
      client_max_body_size 10M;

      root /static;
      index login.html;

      location /api/ {
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;

        gzip off;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header X-Accel-Buffering no;
      }

      location ~ ^/(docs|redoc|openapi\.json) {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Prefix /;
      }

      location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /static;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
      }

      location = /excel {
        root /static;
        try_files /excel.html =404;
      }

      location = / {
        root /static;
        try_files /login.html =404;
      }

      location / {
        root /static;
        try_files $uri $uri/ /login.html;
      }
    }

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cluster-web
  namespace: test-services
spec:
  replicas: 1
  selector:
    matchLabels:
      app: cluster-web
  template:
    metadata:
      labels:
        app: cluster-web
    spec:
      containers:
        - name: nginx
          image: REPLACE_ME_WITH_CLUSTER_WEB_IMAGE
          ports:
            - containerPort: 80
              name: http
          volumeMounts:
            - name: nginx-config
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
      volumes:
        - name: nginx-config
          configMap:
            name: cluster-web-nginx-config

---
apiVersion: v1
kind: Service
metadata:
  name: cluster-web
  namespace: test-services
spec:
  selector:
    app: cluster-web
  ports:
    - name: http
      port: 80
      targetPort: 80
  type: ClusterIP
