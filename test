apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Values.app.name }}
  namespace: {{ .Values.namespace }}
  labels:
    app: {{ .Values.app.name }}
spec:
  replicas: {{ .Values.app.replicas }}
  selector:
    matchLabels:
      app: {{ .Values.app.name }}
  template:
    metadata:
      labels:
        app: {{ .Values.app.name }}
    spec:
      containers:
      - name: {{ .Values.app.name }}
        image: your-java-app:latest
        ports:
        - containerPort: {{ .Values.app.port }}
        envFrom:
        # Загружаем все переменные из ConfigMap
        - configMapRef:
            name: {{ .Values.app.name }}-config
        # Загружаем пароль из Secret
        - secretRef:
            name: {{ .Values.app.name }}-secret
        resources:
          requests:
            memory: "512Mi"
            cpu: "500m"
          limits:
            memory: "1Gi"
            cpu: "1000m"
        livenessProbe:
          httpGet:
            path: /actuator/health
            port: {{ .Values.app.port }}
          initialDelaySeconds: 60
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /actuator/health/readiness
            port: {{ .Values.app.port }}
          initialDelaySeconds: 30
          periodSeconds: 5
