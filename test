git_pull:prod:
  extends:
    - .prod_job
  needs:
    - job: save_credentials:prod
      artifacts: true
  script:
    - cp .netrc ~/.netrc
    - chmod 600 ~/.netrc

    # теперь авторизация точно есть
    - git remote -v
    - git fetch --all
    - git switch main
    - git reset --hard origin/main