prepare_values:
  stage: .pre
  image: alpine:3.19
  script:
    - apk add --no-cache jq gettext
    - echo "$CERT_P12_B64" | base64 -d > truststore.p12
    - kubectl create secret generic rabbitmq-truststore \
        --from-file=truststore.p12 -n service-dev --dry-run=client -o yaml | kubectl apply -f -
    - export HELM_CUSTOM_VALUES_FILE="./values.custom.${CI_PIPELINE_ID}.json"
    - envsubst < custom.json > "${HELM_CUSTOM_VALUES_FILE}"
    - echo "HELM_CUSTOM_VALUES_FILE=${HELM_CUSTOM_VALUES_FILE}" > helm.env
  artifacts:
    paths:
      - values.custom.${CI_PIPELINE_ID}.json
    reports:
      dotenv: helm.env