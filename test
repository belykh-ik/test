apiVersion: v1
kind: ConfigMap
metadata:
  name: campaigns-config-tpl
data:
  application.yaml.tpl: |
    spring:
      kafka:
        security:
          protocol: ${KAFKA_SECURITY_PROTOCOL}
        properties:
          sasl:
            mechanism: ${KAFKA_SASL_MECHANISM}
            jaas:
              enabled: ${KAFKA_JAAS_ENABLED}
              config: >-
                org.apache.kafka.common.security.plain.PlainLoginModule required
                username='${KAFKA_SASL_USERNAME}'
                password='${KAFKA_SASL_PASSWORD}';
        ssl:
          enabled: ${KAFKA_SSL_ENABLED}
          trust-store-location: ${KAFKA_SSL_TRUST_STORE_LOCATION}
          trust-store-password: ${KAFKA_SSL_TRUST_STORE_PASSWORD}
          key-store-location: ${KAFKA_SSL_KEY_STORE_LOCATION}
          key-store-password: ${KAFKA_SSL_KEY_STORE_PASSWORD}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: campaigns
spec:
  replicas: 1
  selector:
    matchLabels:
      app: campaigns
  template:
    metadata:
      labels:
        app: campaigns
    spec:
      # 1) initContainer рендерит шаблон + собирает env
      initContainers:
        - name: render-config
          image: alpine:3.20
          command:
            - sh
            - -c
            - |
              set -eu
              apk add --no-cache gettext >/dev/null

              # Рендерим application.yaml из шаблона (подставятся значения из env, включая секреты)
              envsubst < /tpl/application.yaml.tpl > /work/application.yaml

              # Если нужно "готовое env", собери его в файл export.env
              # (тут пример с одной переменной; добавь нужные)
              cat > /work/export.env <<'EOF'
              # Эти переменные будут "применены" в main контейнере через source
              # Можно создать итоговую строку подключения/jaas/etc.
              # Пример:
              # export DATABASE_URL="postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
              EOF

              chmod 0444 /work/application.yaml /work/export.env

          # Берём секреты из уже созданного Secret (ExternalSecret -> Secret)
          envFrom:
            - secretRef:
                name: cvm-secret-bao
          # Если у тебя есть не-секретные env (верхним регистром) — можно добавлять configMapRef сюда.
          # envFrom:
          #   - configMapRef:
          #       name: global-env-config

          volumeMounts:
            - name: config-tpl
              mountPath: /tpl
            - name: workdir
              mountPath: /work

      # 2) основной контейнер использует готовый конфиг и "применяет" готовые env
      containers:
        - name: app
          image: your-registry/your-app:tag
          imagePullPolicy: IfNotPresent

          # Важно: чтобы "применить export.env", мы стартуем через shell.
          # Для Spring: укажем где лежит application.yaml
          command:
            - sh
            - -c
            - |
              set -eu
              # "Применяем" готовые env-переменные (если ты их сформировал)
              . /work/export.env

              # Говорим Spring где искать конфиг (подхватит /config/application.yaml)
              export SPRING_CONFIG_LOCATION="classpath:/,file:/config/"

              # Запуск приложения (замени под свой entrypoint)
              exec java -jar /app/app.jar

          # Секреты можно и здесь давать напрямую в env (если приложению нужны как env)
          envFrom:
            - secretRef:
                name: cvm-secret-bao

          volumeMounts:
            - name: workdir
              mountPath: /work
            - name: rendered-config
              mountPath: /config

      volumes:
        - name: config-tpl
          configMap:
            name: campaigns-config-tpl
        - name: workdir
          emptyDir: {}
        - name: rendered-config
          emptyDir: {}

      # Копируем rendered-config из workdir в /config через subPath не получится напрямую,
      # поэтому проще: использовать один emptyDir, см. ниже (вариант попроще).