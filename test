# TCP (HTTPS) forward proxy for CONNECT
stream {
    # Proxy listener
    server {
        listen 8888;

        proxy_connect_timeout 10s;
        proxy_timeout 300s;

        # DNS resolver
        resolver 8.8.8.8 1.1.1.1 valid=300s;

        # Tunnel to remote host
        proxy_pass $proxy_host:$proxy_port;
    }
}