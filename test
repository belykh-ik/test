stages:
  - vendor_accept

vendor:accept:
  stage: vendor_accept
  image: alpine:3.20
  rules:
    - if: $CI_COMMIT_BRANCH == "main"
      when: manual
      allow_failure: false
    - when: never
  before_script:
    - apk add --no-cache git bash ca-certificates
    - git config --global user.email "vendor-sync-bot@your.company"
    - git config --global user.name "vendor-sync-bot"
  script:
    - set -euo pipefail
    - set +x

    # ВАЖНО: используем отдельный bot-token с правами write_repository (и push tags)
    # Задай переменные в GitLab CI/CD Variables (masked/protected):
    # BOT_USERNAME, BOT_TOKEN
    - test -n "${BOT_USERNAME:-}" || (echo "BOT_USERNAME is empty" && exit 1)
    - test -n "${BOT_TOKEN:-}" || (echo "BOT_TOKEN is empty" && exit 1)

    # Подменяем origin на URL с кредами только внутри job
    - ORIGIN_URL="$(git remote get-url origin)"
    - ORIGIN_URL_AUTH="https://${BOT_USERNAME}:${BOT_TOKEN}@${ORIGIN_URL#https://}"
    - git remote set-url origin "${ORIGIN_URL_AUTH}"

    # Забираем актуальный vendor/main из origin
    - git fetch origin "+refs/heads/vendor/main:refs/remotes/origin/vendor/main"

    # Ставим тег vendor/last_synced на текущее состояние vendor/main
    - VENDOR_MAIN_COMMIT="$(git rev-parse refs/remotes/origin/vendor/main)"
    - echo "Setting vendor/last_synced -> ${VENDOR_MAIN_COMMIT}"
    - git tag -f vendor/last_synced "${VENDOR_MAIN_COMMIT}"

    # Пушим тег
    - git push -f origin "refs/tags/vendor/last_synced"

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: dev-namespace-admin
  namespace: <NAMESPACE>
subjects:
- kind: User          # или Group — см. ниже
  name: <USERNAME>    # ТОЧНО как приходит от auth (OIDC/cert)
roleRef:
  kind: ClusterRole
  name: admin
  apiGroup: rbac.authorization.k8s.io
