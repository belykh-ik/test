volumes:
  - ./tls:/usr/share/opensearch-dashboards/config/tls:ro
  - ./opensearch-dashboards.yml:/usr/share/opensearch-dashboards/config/opensearch_dashboards.yml:ro
----
server.host: "0.0.0.0"
server.ssl.enabled: true
server.ssl.certificate: /usr/share/opensearch-dashboards/config/tls/server.crt
server.ssl.key: /usr/share/opensearch-dashboards/config/tls/server.key

opensearch.hosts: ["https://opensearch:9200"]
opensearch.username: "admin"
opensearch.password: "admin"
opensearch.ssl.certificateAuthorities: ["/usr/share/opensearch-dashboards/config/tls/ca.crt"]
opensearch.ssl.verificationMode: certificate
