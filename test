#!/usr/bin/env bash
set -euo pipefail

# ===================== НАСТРОЙКИ =====================

# --- Vendor repo (read) ---
VENDOR_URL="${VENDOR_URL:-https://git.vendor.example.com/group/cvm.git}"
VENDOR_BRANCH="${VENDOR_BRANCH:-main}"
VENDOR_GIT_USERNAME="${VENDOR_GIT_USERNAME:-}"
VENDOR_GIT_TOKEN="${VENDOR_GIT_TOKEN:-}"

# --- Our repo (push) ---
OUR_GIT_USERNAME="${OUR_GIT_USERNAME:-}"
OUR_GIT_TOKEN="${OUR_GIT_TOKEN:-}"

# --- Branches in OUR repo ---
OUR_VENDOR_MAIN_BRANCH="vendor/main"
OUR_VENDOR_CHANGES_BRANCH="vendor/changes"
LAST_SYNC_REF="refs/tags/vendor/last_synced"

# =====================================================

die() { echo "❌ $*" >&2; exit 1; }

# --- Проверки ---
[[ -n "$VENDOR_GIT_USERNAME" && -n "$VENDOR_GIT_TOKEN" ]] || die "Нет доступа к git вендора"
[[ -n "$OUR_GIT_USERNAME" && -n "$OUR_GIT_TOKEN" ]] || die "Нет доступа к нашему git"

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "Запусти из git-репозитория"

set +x  # не светим токены

# --- URL'ы с авторизацией ---
VENDOR_URL_AUTH="https://${VENDOR_GIT_USERNAME}:${VENDOR_GIT_TOKEN}@${VENDOR_URL#https://}"

ORIGIN_URL="$(git remote get-url origin | sed 's|https://||')"
ORIGIN_URL_AUTH="https://${OUR_GIT_USERNAME}:${OUR_GIT_TOKEN}@${ORIGIN_URL}"

# --- Настройка remotes ---
git remote set-url origin "$ORIGIN_URL_AUTH"

if git remote get-url vendor >/dev/null 2>&1; then
  git remote set-url vendor "$VENDOR_URL_AUTH"
else
  git remote add vendor "$VENDOR_URL_AUTH"
fi

echo "▶ Fetch из вендора..."
git fetch vendor "+refs/heads/${VENDOR_BRANCH}:refs/remotes/vendor/${VENDOR_BRANCH}"

V_NEW="$(git rev-parse refs/remotes/vendor/${VENDOR_BRANCH})"

if git show-ref --verify --quiet "$LAST_SYNC_REF"; then
  V_OLD="$(git rev-parse "$LAST_SYNC_REF")"
else
  V_OLD=""
fi

if [[ -n "$V_OLD" && "$V_NEW" == "$V_OLD" ]]; then
  echo "✅ Изменений у вендора нет"
  exit 0
fi

# -----------------------------------------------------
# МЕСТО №2 — полный срез
# -----------------------------------------------------
echo "▶ Обновляю vendor/main"
git checkout -B "$OUR_VENDOR_MAIN_BRANCH" "$V_NEW"
git push -f origin "$OUR_VENDOR_MAIN_BRANCH"

# -----------------------------------------------------
# МЕСТО №1 — дельта
# -----------------------------------------------------
echo "▶ Обновляю vendor/changes"

if [[ -z "$V_OLD" ]]; then
  git checkout -B "$OUR_VENDOR_CHANGES_BRANCH" "$V_NEW"
else
  git merge-base --is-ancestor "$V_OLD" "$V_NEW" \
    || die "Нелинейная история вендора"

  git checkout -B "$OUR_VENDOR_CHANGES_BRANCH" "$V_OLD"
  git cherry-pick "$V_OLD..$V_NEW"
fi

git push -f origin "$OUR_VENDOR_CHANGES_BRANCH"

# -----------------------------------------------------
# last_synced
# -----------------------------------------------------
git tag -f vendor/last_synced "$V_NEW"
git push -f origin refs/tags/vendor/last_synced

echo "✅ Синхронизация завершена"
