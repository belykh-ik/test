---
# Digital API Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: digital-api
  labels:
    app: digital-api
spec:
  replicas: 1
  selector:
    matchLabels:
      app: digital-api
  template:
    metadata:
      labels:
        app: digital-api
    spec:
      containers:
      - name: api
        image: nexus.sogaz.ru/digital/digital_api:latest  # ЗАМЕНИ на реальный образ
        ports:
        - containerPort: 8000
          name: http
        env:
        - name: APP_PORT
          value: "8000"
        # PostgreSQL connection (из digital docker-compose)
        - name: POSTGRES_HOST
          value: "digital-postgres-external"
        - name: POSTGRES_PORT
          value: "5432"
        - name: POSTGRES_DB
          valueFrom:
            configMapKeyRef:
              name: digital-api-config
              key: POSTGRES_DATABASE
        - name: POSTGRES_USER
          valueFrom:
            secretKeyRef:
              name: digital-api-secrets
              key: postgres_user
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: digital-api-secrets
              key: postgres_password
        # Redis connection
        - name: REDIS_HOST
          value: "digital-redis-external"
        - name: REDIS_PORT
          value: "6379"
        # RabbitMQ connection
        - name: RABBITMQ_HOST
          value: "digital-rabbitmq-external"
        - name: RABBITMQ_PORT
          value: "5672"
        - name: RABBIT_USERNAME
          valueFrom:
            secretKeyRef:
              name: digital-api-secrets
              key: rabbitmq_user
        - name: RABBIT_PASSWORD
          valueFrom:
            secretKeyRef:
              name: digital-api-secrets
              key: rabbitmq_password
        envFrom:
        - configMapRef:
            name: digital-api-config
            optional: true
        resources:
          requests:
            memory: "256Mi"
            cpu: "200m"
          limits:
            memory: "512Mi"
            cpu: "500m"
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
        livenessProbe:
          httpGet:
            path: /health
            port: 8000
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 3
          failureThreshold: 3
      restartPolicy: Always
      imagePullSecrets:
      - name: nexus-pull-secret

---
# Service для Digital API
apiVersion: v1
kind: Service
metadata:
  name: digital-api
  labels:
    app: digital-api
spec:
  type: ClusterIP
  ports:
  - port: 8000
    targetPort: 8000
    protocol: TCP
    name: http
  selector:
    app: digital-api

---
# ConfigMap для Digital API
apiVersion: v1
kind: ConfigMap
metadata:
  name: digital-api-config
data:
  POSTGRES_DATABASE: "digital_db"  # ЗАМЕНИ на реальное имя БД
  LOG_LEVEL: "INFO"

---
# Secrets для Digital API
apiVersion: v1
kind: Secret
metadata:
  name: digital-api-secrets
type: Opaque
stringData:
  postgres_user: "postgres"
  postgres_password: "your_digital_postgres_password"  # ЗАМЕНИ
  rabbitmq_user: "guest"
  rabbitmq_password: "guest"  # ЗАМЕНИ
