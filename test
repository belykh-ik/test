cluster.name: docker-cluster
node.name: opensearch
network.host: 0.0.0.0

# ===== Transport TLS (node ↔ node) =====
plugins.security.ssl.transport.enabled: true
plugins.security.ssl.transport.pemcert_filepath: tls/server.crt
plugins.security.ssl.transport.pemkey_filepath: tls/server.key
plugins.security.ssl.transport.pemtrustedcas_filepath: tls/ca.crt
plugins.security.ssl.transport.enforce_hostname_verification: false

# ===== HTTP TLS (clients) =====
plugins.security.ssl.http.enabled: true
plugins.security.ssl.http.pemcert_filepath: tls/server.crt
plugins.security.ssl.http.pemkey_filepath: tls/server.key
plugins.security.ssl.http.pemtrustedcas_filepath: tls/ca.crt

# ===== Security bootstrap =====
plugins.security.allow_default_init_securityindex: true

# (опционально, но правильно)
plugins.security.authcz.admin_dn:
  - "CN=client"
----
openssl x509 -in tls/client.crt -noout -subject
----
opensearch:
  image: opensearchproject/opensearch:3.2.0
  container_name: opensearch
  environment:
    - discovery.type=single-node
    - bootstrap.memory_lock=true
    - OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m -Djava.io.tmpdir=/tmp
    - DISABLE_INSTALL_DEMO_CONFIG=true
    - OPENSEARCH_INITIAL_ADMIN_PASSWORD=admin
  ulimits:
    memlock:
      soft: -1
      hard: -1
    nofile:
      soft: 65536
      hard: 65536
  volumes:
    - opensearch-data:/usr/share/opensearch/data
    - ./opensearch.yml:/usr/share/opensearch/config/opensearch.yml:ro
    - ./tls:/usr/share/opensearch/config/tls:ro
  ports:
    - "9200:9200"
  networks:
    - integration-network

--------
opensearch-dashboards:
  image: opensearchproject/opensearch-dashboards:3.2.0
  container_name: opensearch-dashboards
  ports:
    - "5601:5601"
  environment:
    - OPENSEARCH_HOSTS=["https://opensearch:9200"]
    - OPENSEARCH_USERNAME=admin
    - OPENSEARCH_PASSWORD=admin
    - OPENSEARCH_SSL_VERIFICATIONMODE=certificate
    - OPENSEARCH_SSL_CERTIFICATEAUTHORITIES=/usr/share/opensearch-dashboards/config/tls/ca.crt
  volumes:
    - ./tls:/usr/share/opensearch-dashboards/config/tls:ro
  depends_on:
    opensearch:
      condition: service_started
  networks:
    - integration-network

-----------
sinks:
  opensearch:
    type: elasticsearch
    endpoints:
      - "https://opensearch:9200"
    tls:
      ca_file: /etc/vector/tls/ca.crt
      crt_file: /etc/vector/tls/client.crt
      key_file: /etc/vector/tls/client.key
      verify_certificate: true
    auth:
      strategy: basic
      user: admin
      password: admin
    bulk:
      index: "vector-test-%Y.%m.%d"
