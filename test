variables:
  APP_VERSION: "${CI_COMMIT_SHORT_SHA}"
  APP_ARTIFACT_FILE_NAME: "was-server-${APP_VERSION}.jar"

script:
  - mvn clean package -DskipTests
  - mv target/was-server.jar target/${APP_ARTIFACT_FILE_NAME}
  - docker build --build-arg JAR_FILE=${APP_ARTIFACT_FILE_NAME} -t my-app:${APP_VERSION} .
  - docker push my-app:${APP_VERSION}