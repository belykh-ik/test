deploy:
  stage: deploy
  script:
    # 1️⃣ формируем имя сети из ветки
    - export NET_NAME="server-${CI_COMMIT_REF_SLUG}"

    # 2️⃣ создаём сеть, если её нет
    - docker network create "$NET_NAME" || true

    # 3️⃣ заменяем шаблон на реальное имя сети
    - sed "s/server-PLACEHOLDER/${NET_NAME}/g" docker-compose.yml > docker-compose.gen.yml

    # 4️⃣ поднимаем проект
    - docker-compose -f docker-compose.gen.yml up -d