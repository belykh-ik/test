#!/bin/bash

URL="https://example.com/repository/path/to/dir/"   # ← ТВОЙ URL
TOKEN="your_token_here"                             # ← ТВОЙ TOKEN
OUT="./downloaded"                                   # куда сохранить

mkdir -p "$OUT"

# получаем список всех ссылок из каталога
curl -s -H "Private-Token: $TOKEN" "$URL" \
  | grep -oP '(?<=href=")[^"]+' \
  | while read ITEM; do

      # пропускаем родителя
      [[ "$ITEM" == "../" ]] && continue

      echo "Downloading: $ITEM"

      curl -s -H "Private-Token: $TOKEN" \
          -o "$OUT/$ITEM" \
          "${URL}${ITEM}"
done

echo "Done. Files saved to $OUT/"