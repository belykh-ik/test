==============================
 RabbitMQ commands cheat-sheet
==============================

# Примечания:
# - rabbitmqctl работает внутри контейнера RabbitMQ
# - rabbitmqadmin работает через Management API (HTTP), нужен порт 15672
# - Подставляй свои значения: <HOST>, <RABBIT_CONTAINER>, <QUEUE>, <EXCHANGE>, <VHOST>, <USER>, <PASS>


--------------------------------
0) Быстрые переменные (для себя)
--------------------------------
RABBIT_CONTAINER=rabbitmq
HOST=localhost
MGMT_PORT=15672
VHOST=/
USER=dev
PASS=dev


--------------------------------
1) Проверить, что контейнер жив и порты проброшены
--------------------------------
docker ps | grep rabbit

# С хоста проверить доступ к management API:
curl -s -u dev:dev http://localhost:15672/api/overview | head


--------------------------------
2) Список vhost
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_vhosts


--------------------------------
3) Список пользователей
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_users


--------------------------------
4) Права пользователя на vhost
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_permissions -p /

# Выдать полные права (осторожно):
docker exec -it rabbitmq rabbitmqctl set_permissions -p / dev ".*" ".*" ".*"


--------------------------------
5) Список очередей и их метрики
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_queues name messages_ready messages_unacknowledged consumers

# Только одна очередь:
docker exec -it rabbitmq rabbitmqctl list_queues name messages_ready messages_unacknowledged consumers | grep USK-DisPult


--------------------------------
6) Список exchange
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_exchanges name type


--------------------------------
7) Список bindings
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_bindings


--------------------------------
8) Посмотреть consumers (кто читает очередь)
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_consumers


--------------------------------
9) Опубликовать сообщение через rabbitmqadmin (Management API)
--------------------------------
# В exchange usk.dispult с routing_key usk:
docker exec -it rabbitmq rabbitmqadmin \
  -H localhost -P 15672 \
  -u dev -p dev -V / \
  publish exchange=usk.dispult routing_key=usk \
  payload='{"message":"hello from rabbit","stream":"policy","level":"info"}' \
  properties='{"content_type":"application/json"}'

# Через default exchange в очередь (routing_key = имя очереди):
docker exec -it rabbitmq rabbitmqadmin \
  -H localhost -P 15672 \
  -u dev -p dev -V / \
  publish exchange=amq.default routing_key=USK-DisPult \
  payload='{"message":"hello to queue via amq.default","stream":"policy","level":"info"}' \
  properties='{"content_type":"application/json"}'


--------------------------------
10) Проверить, что сообщение попало в очередь
--------------------------------
docker exec -it rabbitmq rabbitmqctl list_queues name messages_ready messages_unacknowledged consumers | grep USK-DisPult


--------------------------------
11) Посмотреть сообщения в очереди (GET через HTTP API)
--------------------------------
# ВАЖНО: это НЕ вытащит сообщения без последствий — может "ack" / "requeue"
# Здесь пример: достать 1 сообщение и вернуть обратно (requeue=true):
curl -s -u dev:dev -H "Content-Type: application/json" \
  -X POST "http://localhost:15672/api/queues/%2F/USK-DisPult/get" \
  -d '{"count":1,"ackmode":"ack_requeue_true","encoding":"auto"}' | head

# Достать 1 сообщение и УДАЛИТЬ (осторожно):
curl -s -u dev:dev -H "Content-Type: application/json" \
  -X POST "http://localhost:15672/api/queues/%2F/USK-DisPult/get" \
  -d '{"count":1,"ackmode":"ack_requeue_false","encoding":"auto"}' | head


--------------------------------
12) Очистить очередь (purge)
--------------------------------
# Через rabbitmqctl:
docker exec -it rabbitmq rabbitmqctl purge_queue USK-DisPult

# Через HTTP API:
curl -s -u dev:dev -X DELETE "http://localhost:15672/api/queues/%2F/USK-DisPult/contents"


--------------------------------
13) Удалить очередь
--------------------------------
docker exec -it rabbitmq rabbitmqctl delete_queue USK-DisPult


--------------------------------
14) Удалить exchange (осторожно)
--------------------------------
docker exec -it rabbitmq rabbitmqctl delete_exchange usk.dispult


--------------------------------
15) Полезные логи RabbitMQ
--------------------------------
docker logs rabbitmq --tail 200

# Внутри контейнера:
docker exec -it rabbitmq sh -c 'ls -lah /var/log/rabbitmq && tail -n 200 /var/log/rabbitmq/rabbit@*.log'


--------------------------------
16) UI (если проброшен порт 15672)
--------------------------------
http://<HOST>:15672
# Queues -> (очередь) -> Publish message / Get messages / Purge
# Exchanges -> (exchange) -> Bindings / Publish message


