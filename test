#!/usr/bin/env bash
set -euo pipefail

BACKPORTS_LIST="/etc/apt/sources.list.d/bookworm-backports.list"
BACKPORTS_LINE="deb http://deb.debian.org/debian bookworm-backports main contrib non-free non-free-firmware"

echo "[*] Проверка, что система — Debian 12 (bookworm)..."
if ! lsb_release -sc | grep -q "bookworm"; then
  echo "[-] Эта система не bookworm. Останов."
  exit 1
fi

echo "[*] Подключение репозитория backports..."

if [ -f "$BACKPORTS_LIST" ]; then
  if grep -q "^deb .*bookworm-backports" "$BACKPORTS_LIST"; then
    echo "[+] backports уже подключен: $BACKPORTS_LIST"
  else
    echo "$BACKPORTS_LINE" | sudo tee -a "$BACKPORTS_LIST"
    echo "[+] Добавлена строка в существующий $BACKPORTS_LIST"
  fi
else
  echo "$BACKPORTS_LINE" | sudo tee "$BACKPORTS_LIST"
  echo "[+] Создан файл $BACKPORTS_LIST"
fi

echo "[*] Обновление индексов пакетов..."
sudo apt update

echo "[*] Установка / обновление OpenJDK 21 из bookworm-backports..."
sudo apt install -t bookworm-backports -y openjdk-21-jdk

echo "[*] Проверка версии Java..."
java -version || {
  echo "[-] java не найдена в PATH, но пакет openjdk-21-jdk установлен. Проверь update-alternatives."
  exit 1
}

echo "[+] Готово. Текущая версия Java выше."