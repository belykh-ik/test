stages:
  - vendor_sync

vendor:sync:
  stage: vendor_sync
  tags:
    - vendor-sync        # <-- поставь тег, который есть у твоего раннера
  image: alpine:3.20
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
      when: on_success
    - when: never
  before_script:
    - apk add --no-cache bash git ca-certificates
  script:
    - chmod +x ./vendor_sync_full.sh
    - ./vendor_sync_full.sh
