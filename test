FROM nexus.test.ru/library/node:22.14.0-bookworm AS build
WORKDIR /usr/src/email-editor
COPY .npmrc /root/.npmrc
COPY package.json package-lock.json ./
RUN npm install
COPY . .
RUN npm run build


### STAGE 2: Run
FROM nexus.test.ru/library/nginx:1.23.1-alpine

USER root
RUN mkdir -p /var/cache/nginx && chmod -R 777 /var/cache/nginx

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from-build /usr/src/email-editor/dist /usr/share/nginx/html

USER nginx