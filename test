# 1) Должен существовать сервис kubernetes и его ClusterIP
kubectl get svc kubernetes -o wide

# 2) Должны быть endpoints сервиса kubernetes (у тебя есть: 10.191.71.130:6443)
kubectl get ep kubernetes -o wide

# 3) Посмотреть, что kube-proxy реально в ipvs-mode (у тебя mode: ipvs)
kubectl -n kube-system get cm kube-proxy -o yaml | sed -n '1,200p'

# 4) На ноде (в Linux) — есть ли ipvs-таблица и есть ли там VIP 10.233.0.1:443
ipvsadm -Ln | head -n 50
ipvsadm -Ln | grep -E '10\.233\.0\.1:443|10\.233\.0\.1' || true

# 5) Должен быть маршрут/локальный адрес для VIP (обычно через dummy интерфейс kube-ipvs0)
ip -br addr | grep -E 'kube-ipvs0|10\.233\.0\.1' || true
