# Разрешаем основные порты Kubernetes
sudo ufw allow 6443/tcp comment 'Kubernetes API server'
sudo ufw allow 10250/tcp comment 'Kubelet API'
sudo ufw allow 10251/tcp comment 'kube-scheduler'
sudo ufw allow 10252/tcp comment 'kube-controller-manager'
sudo ufw allow 2379:2380/tcp comment 'etcd'

# Разрешаем Calico BGP
sudo ufw allow 179/tcp comment 'Calico BGP'

# Разрешаем VXLAN (Calico)
sudo ufw allow 4789/udp comment 'Calico VXLAN'

# Разрешаем весь трафик для pod/service CIDR
sudo ufw allow from 10.233.0.0/18
sudo ufw allow to 10.233.0.0/18

# Перезагружаем правила
sudo ufw reload
