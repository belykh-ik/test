initContainers:
  - name: render-redisson-config
    image: alpine:3.20
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -e
        apk add --no-cache gettext
        envsubst < /tpl/redisson-conf.yaml.tpl > /out/redisson-conf.yaml
        chmod 0444 /out/redisson-conf.yaml
    env:
      - name: REDIS_PASS
        valueFrom:
          secretKeyRef:
            name: redis-secret
            key: REDIS_PASS
    volumeMounts:
      - name: redisson-tpl
        mountPath: /tpl
        readOnly: true
      - name: redisson-rendered
        mountPath: /out
