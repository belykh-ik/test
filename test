# External Services для подключения к Docker контейнерам
# На основе docker ps вывода:
# - cluster_dms_db: 0.0.0.0:5445->5432/tcp
# - digital_db: 0.0.0.0:5444->5432/tcp
# - cluster_dms_redis: 0.0.0.0:6379->6379/tcp (общий для обоих)
# - cluster_dms_rabbitmq: 5672,15672 (общий для обоих)

# ВАЖНО: Замени IP 192.168.1.100 на реальный IP Docker хоста!

---
# ==========================================
# CLUSTER NETWORK SERVICES
# ==========================================

# Cluster PostgreSQL External Service (порт 5445 на хосте)
apiVersion: v1
kind: Service
metadata:
  name: cluster-postgres-external
  labels:
    app: cluster-postgres
spec:
  clusterIP: None  # Headless service
  ports:
  - port: 5432
    protocol: TCP
    name: postgres
---
apiVersion: v1
kind: Endpoints
metadata:
  name: cluster-postgres-external
subsets:
  - addresses:
      - ip: 192.168.1.100  # ЗАМЕНИ на IP Docker хоста
    ports:
      - port: 5445  # Внешний порт из docker: 0.0.0.0:5445->5432/tcp
        name: postgres

---
# Cluster Redis External Service (порт 6379 - общий)
apiVersion: v1
kind: Service
metadata:
  name: cluster-redis-external
  labels:
    app: cluster-redis
spec:
  clusterIP: None
  ports:
  - port: 6379
    protocol: TCP
    name: redis
---
apiVersion: v1
kind: Endpoints
metadata:
  name: cluster-redis-external
subsets:
  - addresses:
      - ip: 192.168.1.100  # ЗАМЕНИ на IP Docker хоста
    ports:
      - port: 6379  # cluster_dms_redis: 0.0.0.0:6379->6379/tcp
        name: redis

---
# Cluster RabbitMQ External Service (общий контейнер cluster_dms_rabbitmq)
apiVersion: v1
kind: Service
metadata:
  name: cluster-rabbitmq-external
  labels:
    app: cluster-rabbitmq
spec:
  clusterIP: None
  ports:
  - port: 5672
    protocol: TCP
    name: amqp
  - port: 15672
    protocol: TCP
    name: management
---
apiVersion: v1
kind: Endpoints
metadata:
  name: cluster-rabbitmq-external
subsets:
  - addresses:
      - ip: 192.168.1.100  # ЗАМЕНИ на IP Docker хоста
    ports:
      - port: 5672
        name: amqp
      - port: 15672
        name: management

---
# ==========================================
# DIGITAL NETWORK SERVICES
# ==========================================

# Digital PostgreSQL External Service (порт 5444 на хосте)
apiVersion: v1
