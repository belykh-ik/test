stages:
  - security
  - deploy
  - rollback

deploy_dev:
  stage: deploy
  variables:
    GIT_STRATEGY: clone
  environment:
    name: dev
  script:
    - echo ">>> Установка зависимостей"
    - npm ci --no-cache --verbose --registry=https://nexus.sogaz.ru/repository/npm-proxy/
    - echo ">>> Сборка фронта"
    - npm run release
    - echo ">>> Подготовка директории релиза"
    - RELEASE_DIR="/var/www/releases/$(date +%Y%m%d%H%M%S)"
    - mkdir -p "$RELEASE_DIR"
    - cp -r build/documentation/* "$RELEASE_DIR"
    - echo ">>> Переключение симлинка на новую версию"
    - ln -sfn "$RELEASE_DIR" /var/www/edo-dev
    - sudo systemctl reload nginx
    - echo ">>> Очистка старых билдов"
    - ls -dt /var/www/releases/* | tail -n +4 | xargs rm -rf || true
  tags:
    - test-fe
  rules:
    - if: '$CI_COMMIT_BRANCH == "dev"'

rollback_dev:
  stage: rollback
  script:
    - echo ">>> Доступные релизы:"
    - ls -dt /var/www/releases/* | head -n 5
    - echo ">>> Откат на предыдущий релиз"
    - PREV_RELEASE=$(ls -dt /var/www/releases/* | sed -n '2p')
    - echo "Будет выбран: $PREV_RELEASE"
    - ln -sfn "$PREV_RELEASE" /var/www/edo-dev
    - sudo systemctl reload nginx
    - echo "Откат выполнен. Текущий релиз:"
    - readlink -f /var/www/edo-dev
  tags:
    - test-fe
  when: manual
  allow_failure: false