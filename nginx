worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;

events {
    worker_connections 4096;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Формат access-логов (опционально)
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    # -------------------------------
    # HTTP → HTTPS редирект
    # -------------------------------
    server {
        listen 80;
        listen [::]:80;
        server_name s00-0000-cb06.sogaz.ru;
        return 301 https://$host$request_uri;
    }

    # -------------------------------
    # HTTPS сервер
    # -------------------------------
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name s00-0000-cb06.sogaz.ru;

        # Пути к сертификатам — замени на свои
        ssl_certificate     /etc/letsencrypt/live/s00-0000-cb06.sogaz.ru/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/s00-0000-cb06.sogaz.ru/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;
        ssl_ciphers 'EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH';

        # HSTS — можно включить после тестирования HTTPS
        # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # Защита от некоторых атак
        add_header X-Frame-Options SAMEORIGIN;
        add_header X-Content-Type-Options nosniff;
        add_header X-XSS-Protection "1; mode=block";

        # Таймауты и лимиты
        proxy_read_timeout 60s;
        client_max_body_size 50M;

        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}