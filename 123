apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: rabbitmq-ui
  namespace: rabbitmq-namespace
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  ingressClassName: nginx
  rules:
    - host: rabbitmq.example.com      # 👈 твой домен / поддомен
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: rabbitmq        # 👈 имя сервиса RabbitMQ
                port:
                  number: 15672