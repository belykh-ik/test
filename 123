#!/usr/bin/env bash
set -e

# 1. 📥 Экспортируем переменную среды
export MY_KEY="my_value"

# 2. 📝 Добавляем переменную в .env
echo "MY_KEY=$MY_KEY" >> .env

# 3. 🧹 Чистим .env: удаляем пустые строки, кавычки и пробелы вокруг "="
sed -i '/^$/d' .env
sed -i 's/["'\'']//g' .env
sed -i 's/ *= */=/' .env
# Убираем возможные \r (Windows переносы строк)
sed -i 's/\r$//' .env

# 4. 🧪 Проверка валидности
echo "👉 Проверка валидности .env"
if grep -qvE '^[A-Za-z_][A-Za-z0-9_]*=.*$' .env; then
  echo "❌ Обнаружены невалидные строки:"
  grep -n -vE '^[A-Za-z_][A-Za-z0-9_]*=.*$' .env
  exit 1
else
  echo "✅ .env валидный"
fi

# 5. 🕵️ Проверка результата
echo
echo "📄 Текущее содержимое .env:"
cat .env