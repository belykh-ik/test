#!/usr/bin/env bash
set -euo pipefail

# 📁 Временный файл с JSON — имитируем GitLab переменную HELM_APP_ENV_DEV
# В реальном CI это значение можно получить из переменной окружения:
#   echo "$HELM_APP_ENV_DEV" > helm_app_env.json
cat > helm_app_env.json <<'EOF'
{
  "application": {
    "env": {
      "MY_VAR": "MY_VALUE",
      "MY_OTHER_VAR": "MY_OTHER_VALUE"
    },
    "secret": {
      "MY_SECRET_VAR": "MY_SECRET_VALUE",
      "MY_OTHER_SECRET_VAR": "MY_OTHER_SECRET_VALUE"
    }
  }
}
EOF

echo "✅ JSON с переменными сохранён в helm_app_env.json"

# 🧪 Проверяем что jq установлен
if ! command -v jq &>/dev/null; then
  echo "❌ jq не установлен. Установи: apt install -y jq (или аналог для твоей ОС)"
  exit 1
fi

# 🧾 Преобразуем JSON в .env
jq -r '.application.env | to_entries[] | "\(.key)=\(.value)"' helm_app_env.json > .env
jq -r '.application.secret | to_entries[] | "\(.key)=\(.value)"' helm_app_env.json >> .env

# 🧹 Чистим файл от возможных лишних символов
sed -i '/^$/d' .env
sed -i 's/["'\'']//g' .env
sed -i 's/ *= */=/' .env
sed -i 's/\r$//' .env

# ✅ Проверка валидности .env
if grep -qvE '^[A-Za-z_][A-Za-z0-9_]*=.*$' .env; then
  echo "❌ Обнаружены невалидные строки в .env:"
  grep -n -vE '^[A-Za-z_][A-Za-z0-9_]*=.*$' .env
  exit 1
else
  echo "✅ .env прошёл проверку"
fi

# 🪄 Показать содержимое
echo "📄 Содержимое .env:"
cat .env